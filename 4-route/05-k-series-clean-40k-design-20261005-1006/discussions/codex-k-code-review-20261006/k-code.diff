+# --------------------------------------------------------------------------
+def save_model_checkpoint(path: Path, resolved, *, arm: str = ARM, seed: int = SEED, step: int = STEP, model=None,
+                          **identity_changes):
+    """A checkpoint written by the trainer's own save_checkpoint; the identity as the trainer builds it.  Returns the
+    network whose weights it holds (a new seeded one unless ``model`` is given)."""
+    import torch  # noqa: PLC0415
+
+    from common.petct_sirb_checkpoint import (  # noqa: PLC0415
+        IDENTITY_ARM_SPEC, IDENTITY_INPUT_PROBES_SKIPPED, arm_spec_record, make_run_plan)
+    from common.petct_sirb_network import build_sirb_network  # noqa: PLC0415
+    from common.petct_sirb_training import ExposureCounters, save_checkpoint  # noqa: PLC0415
+
+    model = build_sirb_network(resolved, arm, seed) if model is None else model
+    identity = {"training_sha256": resolved["training_sha256"], "arm_id": arm, "seed": seed,
+                "pair_manifest_sha256": "0" * 64, "total_steps": make_run_plan(resolved, arm, seed).total_steps,
+                "numerics": {"profile": "test"}, "sequence_offset": 0, IDENTITY_INPUT_PROBES_SKIPPED: False,
+                IDENTITY_ARM_SPEC: arm_spec_record(arm)}
+    identity.update(identity_changes)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    save_checkpoint(path, model=model, optimizer=torch.optim.AdamW(model.parameters(), lr=1e-3), step=step,
+                    counters=ExposureCounters(), identity=identity)
+    return model
+
+
+def model_request(root: Path, resolved, *, arm: str = ARM, seed: int = SEED, step: int = STEP, refresh_index: int = 0,
+                  request_arm: str | None = None, request_seed: int | None = None, payload_step: int | None = None,
+                  **identity_changes) -> tuple[Path, dict]:
+    run = make_run(root, f"PETCT-EDITOR-SIRB-{arm}-S{seed}-TRAIN-20261006-R1")
+    save_model_checkpoint(run / refresh.refresh_checkpoint_relpath(step), resolved, arm=arm, seed=seed,
+                          step=step if payload_step is None else payload_step, **identity_changes)
+    path = refresh.write_request(run, arm=request_arm or arm, seed=seed if request_seed is None else request_seed,
+                                 step=step, refresh_index=refresh_index)
+    return run, refresh.read_request(path)
+
