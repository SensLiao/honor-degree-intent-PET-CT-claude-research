+@pytest.mark.parametrize("arm", ["INTENT_FULL", "INTENT_WIDE"])
+def test_activation_checkpointing_gives_the_same_loss_and_gradients(disk, resolved, monkeypatch, arm):
+    data = k_dataset(disk, resolved, arm)
+    unit = next(data[index] for index in range(len(data)) if data[index].meta["relation"]["kind"] != "none")
+    calls = []
+    real = network_module.checkpoint
+    monkeypatch.setattr(network_module, "checkpoint", lambda *a, **k: calls.append(1) or real(*a, **k))
+    results = {}
+    for switch in (False, True):
+        model = build_sirb_network(resolved, arm, SEED)
+        model.state.activation_checkpointing = switch
+        calls.clear()
+        total, loss = unit_loss(model, unit.inputs, unit.labels, resolved, 0.25,
+                                term_multipliers={TERM_DICE_GAIN: 3.0})
+        trainable = [parameter for parameter in model.parameters() if parameter.requires_grad]
+        norms = term_gradient_norms(loss, trainable)              # autograd.grad on the retained graph first
+        total.backward()
+        results[switch] = (total.detach(), {name: float(value) for name, value in norms.items()},
+                           {name: parameter.grad.clone() for name, parameter in model.named_parameters()
+                            if parameter.grad is not None})
+        assert bool(calls) == switch, (switch, len(calls))         # the switch really changes the forward
+    (off_total, off_norms, off_grads), (on_total, on_norms, on_grads) = results[False], results[True]
+    torch.testing.assert_close(on_total, off_total, rtol=1e-6, atol=1e-7)
+    assert on_norms.keys() == off_norms.keys()
+    for name, value in off_norms.items():
+        assert on_norms[name] == pytest.approx(value, rel=1e-5, abs=1e-8), name
+    assert on_grads.keys() == off_grads.keys() and len(off_grads) > 0
+    for name, value in off_grads.items():
+        torch.testing.assert_close(on_grads[name], value, rtol=1e-5, atol=1e-7, msg=name)
