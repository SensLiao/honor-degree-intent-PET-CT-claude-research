+"""Experiment config files of the SIRB-Net editor: one experiment, one JSON file (D-2026-10-05-02).
+
+Reading name: 编辑器-指代绑定网络-实验配置.  Director 2026-10-05 evening: a new experiment or ablation adds a config file
+under ``configs/sirb/experiments/`` (registry EXPERIMENT_CONFIG_RELATIVE_DIR) and no code; the code only checks that a
+combination of switches is legal.  This module reads every ``*.json`` file of that folder, checks it and builds the
+registry ``ArmSpec`` of its arm.  The registry merges those arms into ``ARM_REGISTRY`` while it is imported, so every
+consumer (trainer, rollout and same-state entries, intent-row recompute, scorer fit, weight average, queue) reads a
+config arm exactly like an arm registered in code; the arms registered in code stay as they were.
+
+A file holds exactly these keys::
+
+    experiment        self-describing name of the experiment (部分-对象-动作), equal to the file name without .json
+    arm_id            the registry arm id (the launch include's run-id rule ^[A-Z][A-Z0-9_]*$; not an arm of the code)
+    description       free text; becomes ArmSpec.note
+    init              "scratch": trained from random initialisation, no parent weights (D-2026-10-05-01)
+    reads_state_pool  true when the run reads the state pool (the trainer's --onpolicy-pair-manifest); the trainer then
+                      requires model-induced rows, and refuses them otherwise (petct_sirb_training.check_pools)
+    switches          ArmSpec fields: head and state_loss always, any other field that differs from its default
+    refresh           optional (K2): {"at_steps": [steps of the formal recipe], "new_state_share": share}
+    provenance        optional free text (decisions, plan sections); no code reads it
+
+Steps in a file are optimizer steps of the formal recipe (the plan's 40,000-step run).
+``petct_sirb_checkpoint.run_schedule`` maps them onto the resolved recipe (the CPU smoke config scales them) and checks
+them against its checkpoint interval and step budget, because those are recipe values; everything else is checked here.
+Every refusal names the file and prints the value found and the value expected.
+
+Import order: the registry imports this module while it builds ARM_REGISTRY, so this module reads the registry only
+inside its functions (:func:`_registry`), and never imports a module that imports the registry at load time (the
+recipe module petct_sirb_config does); it reads JSON with petct_sirb_io.strict_json_loads, the one strict parser.
+"""
+
+from __future__ import annotations
+
+import math
+import re
+from dataclasses import MISSING, dataclass, fields
+from pathlib import Path
+from types import MappingProxyType, ModuleType
+from typing import Any, Mapping
+
+from common.petct_sirb_io import strict_json_loads
+
+#: File suffix of an experiment config file; any other file in the folder is ignored (a README, say).
+EXPERIMENT_FILE_SUFFIX = ".json"
+#: Keys of an experiment file (module docstring); a key outside both tuples is refused.
+REQUIRED_KEYS = ("experiment", "arm_id", "description", "init", "reads_state_pool", "switches")
+OPTIONAL_KEYS = ("refresh", "provenance")
+#: Keys of the K2 ``refresh`` block (experiment-schedule-gpus.md part 二 "K2 刷新的固定做法"): the formal steps of the
+#: refreshes, and the share of the state-pool draws that go to the states the refreshes added (the rest keep the base
+#: pool's gap-weighted rule).  Which patients a refresh rolls out is petct_sirb_refresh.half_for_refresh's rule.
+REFRESH_KEYS = ("at_steps", "new_state_share")
+#: Experiment names: lowercase words joined by hyphens (petct-naming-convention, 部分-对象-动作).
+EXPERIMENT_NAME_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)+$")
+#: ArmSpec annotation tokens and the JSON values each one admits (ArmSpec field types, read from the dataclass).
+TYPE_TOKENS = ("bool", "str", "int", "float", "None")
+
+
+class ExperimentConfigError(ValueError):
+    """An experiment file is malformed, or asks for an illegal combination of switches."""
+
+
+def _registry() -> ModuleType:
+    """The registry module.  Imported here and not at the top: the registry imports THIS module while it builds
+    ARM_REGISTRY, and by then every registry name this module uses is defined (module docstring)."""
+    from common import petct_sirb_registry  # noqa: PLC0415
+
+    return petct_sirb_registry
+
+
+@dataclass(frozen=True)
+class RefreshSchedule:
+    """K2: the formal steps of the online state refreshes and the share of new states in the state-pool draw."""
+
+    at_steps: tuple[int, ...]
+    new_state_share: float
+
+
+@dataclass(frozen=True)
+class Experiment:
+    """One experiment file, checked: the arm it registers and what the trainer reads besides the ArmSpec."""
+
+    name: str
+    arm_id: str
+    source: str                          # the file, relative to the project root (POSIX)
+    init: str
+    reads_state_pool: bool
+    arm_spec: Any                        # registry.ArmSpec
+    refresh: RefreshSchedule | None
+    document: Mapping[str, Any]          # the file as parsed
+
+    @property
+    def continuation(self) -> bool:
+        """Does the arm start from a parent's final weights?  Every registered init value today is from scratch."""
+        return self.init != _registry().EXPERIMENT_INIT_SCRATCH
+
+    def record(self) -> dict[str, Any]:
+        """What a run manifest records of the experiment: the file's path and its parsed content."""
+        return {"source": self.source, "document": dict(self.document)}
+
+
+def experiment_config_dir() -> Path:
+    """The project's experiment folder (registry EXPERIMENT_CONFIG_RELATIVE_DIR)."""
+    return Path(__file__).resolve().parents[2] / _registry().EXPERIMENT_CONFIG_RELATIVE_DIR
+
+
+def _refuse(path: Path, message: str) -> ExperimentConfigError:
+    return ExperimentConfigError(f"experiment file {path}: {message}")
+
+
+def _type_tokens(annotation: Any) -> frozenset[str]:
+    """``"int | None"`` -> {"int", "None"}: the tokens of an ArmSpec annotation (the registry module postpones
+    annotations, so they are strings)."""
+    tokens = frozenset(part.strip() for part in str(annotation).split("|"))
+    unknown = sorted(tokens - set(TYPE_TOKENS))
+    if unknown:
+        raise ExperimentConfigError(f"ArmSpec annotation {annotation!r}: tokens {unknown} not in {TYPE_TOKENS}")
+    return tokens
+
+
+def _admits(tokens: frozenset[str], value: Any) -> bool:
+    if value is None:
+        return "None" in tokens
+    if isinstance(value, bool):
+        return "bool" in tokens
+    if isinstance(value, str):
+        return "str" in tokens
+    if isinstance(value, int):
+        return "int" in tokens or "float" in tokens
+    if isinstance(value, float):
+        return "float" in tokens and math.isfinite(value)
+    return False
+
+
+def switch_fields() -> dict[str, frozenset[str]]:
+    """Every ArmSpec field a file may set, with the value types it admits: all fields but the bookkeeping ones the
+    loader fills itself (registry ARM_SPEC_BOOKKEEPING_FIELDS: arm_id from the file, core False, parent_arm None,
+    note from the description)."""
+    registry = _registry()
+    return {field.name: _type_tokens(field.type) for field in fields(registry.ArmSpec)
+            if field.name not in registry.ARM_SPEC_BOOKKEEPING_FIELDS}
+
+
+def required_switches() -> tuple[str, ...]:
+    """The ArmSpec fields without a default (head, state_loss): every file states them."""
+    registry = _registry()
+    return tuple(field.name for field in fields(registry.ArmSpec)
+                 if field.name not in registry.ARM_SPEC_BOOKKEEPING_FIELDS
+                 and field.default is MISSING and field.default_factory is MISSING)
+
+
+def _arm_spec(path: Path, arm_id: str, description: str, switches: Mapping[str, Any]) -> Any:
+    registry = _registry()
+    if not isinstance(switches, Mapping):
+        raise _refuse(path, f"switches actual={type(switches).__name__} expected a JSON object")
+    allowed = switch_fields()
+    unknown = sorted(set(switches) - set(allowed))
+    if unknown:
+        raise _refuse(path, f"switches unknown={unknown} allowed={sorted(allowed)}")
+    missing = [name for name in required_switches() if name not in switches]
+    if missing:
+        raise _refuse(path, f"switches missing={missing} required={list(required_switches())}")
+    values = {}
+    for name, value in switches.items():
+        tokens = allowed[name]
+        if not _admits(tokens, value):
+            raise _refuse(path, f"switch {name} actual={value!r} ({type(value).__name__}) expected one of "
+                                f"{sorted(tokens)}")
+        values[name] = float(value) if tokens == {"float"} else value
+    return registry.ArmSpec(arm_id=arm_id, core=False, parent_arm=None, note=description, **values)
+
+
+def _refresh(path: Path, block: Any) -> RefreshSchedule:
+    if not isinstance(block, Mapping) or sorted(block) != sorted(REFRESH_KEYS):
+        keys = sorted(block) if isinstance(block, Mapping) else type(block).__name__
+        raise _refuse(path, f"refresh keys actual={keys} expected={sorted(REFRESH_KEYS)}")
+    steps = block["at_steps"]
+    if not isinstance(steps, list) or not steps or not all(
+            isinstance(step, int) and not isinstance(step, bool) and step >= 1 for step in steps):
+        raise _refuse(path, f"refresh at_steps actual={steps!r} expected a non-empty list of integers >= 1")
+    if steps != sorted(set(steps)):
+        raise _refuse(path, f"refresh at_steps actual={steps} expected strictly increasing={sorted(set(steps))}")
+    share = block["new_state_share"]
+    if isinstance(share, bool) or not isinstance(share, (int, float)) or not math.isfinite(share) \
+            or not 0.0 < float(share) <= 1.0:
+        raise _refuse(path, f"refresh new_state_share actual={share!r} expected a number in (0, 1]")
+    return RefreshSchedule(tuple(int(step) for step in steps), float(share))
+
+
+def check_experiment(path: Path, experiment: Experiment) -> None:
+    """The combination rules of one experiment (each refusal names the file and prints both values).  The value rules
+    of the ArmSpec itself are the registry's check_arm_registry, run here too so the message names the file."""
+    registry = _registry()
+    spec = experiment.arm_spec
+    try:
+        registry.check_arm_registry({spec.arm_id: spec})
+    except ValueError as error:
+        raise _refuse(path, str(error)) from error
+    if experiment.init not in registry.EXPERIMENT_INITS:
+        raise _refuse(path, f"init actual={experiment.init!r} allowed={list(registry.EXPERIMENT_INITS)} "
+                            "(D-2026-10-05-01: every candidate trains from scratch; a continuation arm is registered "
+                            "in code)")
+    if spec.pool_mix != registry.POOL_MIX_V2 and not experiment.reads_state_pool:
+        raise _refuse(path, f"switch pool_mix={spec.pool_mix!r} draws from the state pool: reads_state_pool "
+                            "actual=false expected=true")
+    if experiment.refresh is not None and not experiment.reads_state_pool:
+        raise _refuse(path, "refresh adds states to the state-pool share of the draw: reads_state_pool actual=false "
+                            "expected=true")
+    if spec.loss_alignment == registry.LOSS_ALIGNMENT_DICE_GAIN_AT_STEP and not spec.edit_contract:
+        raise _refuse(path, f"switch loss_alignment={spec.loss_alignment!r} calibrates the soft Dice gain of the "
+                            "edit contract: edit_contract actual=false expected=true")
+    if spec.loss_alignment is not False and not (spec.edit_contract or spec.pair_relations):
+        raise _refuse(path, f"switch loss_alignment={spec.loss_alignment!r} aligns group-B loss terms: "
+                            "edit_contract or pair_relations actual=false expected=true")
+    if spec.trunk_width_scale != 1.0 and experiment.continuation:
+        raise _refuse(path, f"switch trunk_width_scale={spec.trunk_width_scale!r} needs init "
+                            f"{registry.EXPERIMENT_INIT_SCRATCH!r}: a widened trunk cannot load a parent's weights; "
+                            f"init actual={experiment.init!r}")
+    if spec.continuation_steps is not None and not experiment.continuation:
+        raise _refuse(path, f"switch continuation_steps={spec.continuation_steps!r} is the budget of a continuation; "
+                            f"init actual={experiment.init!r} trains the formal step count")
+
+
+def read_experiment(path: Path, *, code_arms: Mapping[str, Any]) -> Experiment:
+    """One experiment file, parsed and checked (module docstring)."""
+    registry = _registry()
+    path = Path(path)
+    try:
+        document = strict_json_loads(path.read_text(encoding="utf-8"), error=ExperimentConfigError)
+    except ExperimentConfigError as error:
+        raise _refuse(path, str(error)) from error
+    except ValueError as error:                     # malformed JSON
+        raise _refuse(path, f"not JSON: {error}") from error
+    if not isinstance(document, Mapping):
+        raise _refuse(path, f"actual={type(document).__name__} expected a JSON object")
+    missing = [key for key in REQUIRED_KEYS if key not in document]
+    unknown = sorted(set(document) - set(REQUIRED_KEYS) - set(OPTIONAL_KEYS))
+    if missing or unknown:
+        raise _refuse(path, f"keys missing={missing} unknown={unknown} expected={list(REQUIRED_KEYS)} plus optional "
+                            f"{list(OPTIONAL_KEYS)}")
+    name = document["experiment"]
+    if not isinstance(name, str) or not EXPERIMENT_NAME_PATTERN.match(name) or name != path.stem:
+        raise _refuse(path, f"experiment actual={name!r} expected the file name {path.stem!r} matching "
+                            f"{EXPERIMENT_NAME_PATTERN.pattern}")
+    arm_id = document["arm_id"]
+    if not isinstance(arm_id, str) or not re.match(registry.ARM_ID_PATTERN, arm_id):
+        raise _refuse(path, f"arm_id actual={arm_id!r} expected to match {registry.ARM_ID_PATTERN}")
+    if arm_id in code_arms:
+        raise _refuse(path, f"arm_id {arm_id!r} is registered in code already (petct_sirb_registry.CODE_ARM_REGISTRY); "
+                            "expected a new arm id")
+    description = document["description"]
+    if not isinstance(description, str) or not description.strip():
+        raise _refuse(path, f"description actual={description!r} expected non-empty text")
+    if not isinstance(document["reads_state_pool"], bool):
+        raise _refuse(path, f"reads_state_pool actual={document['reads_state_pool']!r} expected true or false")
+    project = Path(__file__).resolve().parents[2]
+    try:
+        source = path.resolve().relative_to(project).as_posix()
+    except ValueError:                              # a folder outside the project (tests)
+        source = path.resolve().as_posix()
+    experiment = Experiment(
+        name=name, arm_id=arm_id, source=source, init=document["init"],
+        reads_state_pool=document["reads_state_pool"],
+        arm_spec=_arm_spec(path, arm_id, description, document["switches"]),
+        refresh=_refresh(path, document["refresh"]) if "refresh" in document else None,
+        document=MappingProxyType(dict(document)))
+    check_experiment(path, experiment)
+    return experiment
+
+
+def load_experiments(directory: Path | None = None, *,
+                     code_arms: Mapping[str, Any] | None = None) -> Mapping[str, Experiment]:
+    """Every experiment file of ``directory`` (default: the project's folder), checked, by arm id in file-name order.
+    No folder means no experiment.  An arm id defined by two files is refused with both files."""
+    registry = _registry()
+    folder = experiment_config_dir() if directory is None else Path(directory)
+    code_arms = registry.CODE_ARM_REGISTRY if code_arms is None else code_arms
+    experiments: dict[str, Experiment] = {}
+    if not folder.is_dir():
+        return MappingProxyType(experiments)
+    for path in sorted(folder.glob("*" + EXPERIMENT_FILE_SUFFIX)):
+        experiment = read_experiment(path, code_arms=code_arms)
+        if experiment.arm_id in experiments:
+            raise ExperimentConfigError(f"arm_id {experiment.arm_id!r} is defined twice: "
+                                        f"{experiments[experiment.arm_id].source} and {experiment.source}")
+        experiments[experiment.arm_id] = experiment
+    return MappingProxyType(experiments)
