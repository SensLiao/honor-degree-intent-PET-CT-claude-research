+
+# --------------------------------------------------------------------------
+# where things are
+# --------------------------------------------------------------------------
+def refresh_dir(run_dir: Path) -> Path:
+    return Path(run_dir) / REFRESH_DIR
+
+
+def request_path(run_dir: Path, step: int) -> Path:
+    return refresh_dir(run_dir) / f"{REQUEST_STEM}-{int(step)}{JSON_SUFFIX}"
+
+
+def record_path(run_dir: Path, step: int) -> Path:
+    """The completion record of the refresh at ``step``; it exists only when that refresh is complete."""
+    return refresh_dir(run_dir) / f"{RECORD_STEM}-{int(step)}{JSON_SUFFIX}"
+
+
+def rollout_dir(run_dir: Path, step: int) -> Path:
+    return refresh_dir(run_dir) / f"{ROLLOUT_STEM}-{int(step)}"
+
+
+def pool_dir(run_dir: Path, step: int) -> Path:
+    return refresh_dir(run_dir) / f"{POOL_STEM}-{int(step)}"
