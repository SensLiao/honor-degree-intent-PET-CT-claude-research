+
+def refresh_checkpoint_relpath(step: int) -> str:
+    """The refresh checkpoint of ``step``, relative to the run directory, with forward slashes."""
+    return REFRESH_CHECKPOINT_TEMPLATE.format(step=int(step))
+
+
+def run_names(run_dir: Path) -> list[str]:
+    """The run directory's name as given and through links (a run reached through a link keeps its run id)."""
+    return sorted({Path(run_dir).absolute().name, Path(run_dir).resolve().name})
+
+
+def inside_run(run_dir: Path, relative: str, what: str) -> Path:
+    """``run_dir / relative`` for a relative POSIX path that stays inside the run directory; anything else refused."""
+    parts = PurePosixPath(str(relative)).parts
+    if not parts or PurePosixPath(str(relative)).is_absolute() or ".." in parts or "\\" in str(relative) \
+            or ":" in str(relative):
+        raise RefreshError(f"{what}: actual={relative!r} expected a relative path inside the run directory")
+    return Path(run_dir).joinpath(*parts)
+
+
+def relative_to_run(run_dir: Path, path: Path) -> str:
+    return Path(path).relative_to(Path(run_dir)).as_posix()
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+# --------------------------------------------------------------------------
+# patient halves
+# --------------------------------------------------------------------------
+def patient_half(patient_id: str) -> int:
+    """0 or 1: the sha256 of the patient id (UTF-8) as an integer, modulo PATIENT_HALVES.  A patient id, never a scan
+    id, so all scans of a patient fall in one half."""
+    if not isinstance(patient_id, str) or not patient_id:
+        raise RefreshError(f"patient id: actual={patient_id!r} expected a non-empty string")
+    return int(hashlib.sha256(patient_id.encode("utf-8")).hexdigest(), 16) % PATIENT_HALVES
+
+
+def half_for_refresh(refresh_index: int) -> int:
+    """The patient half of the refresh with this 0-based index (the plan's first refresh is index 0)."""
+    if isinstance(refresh_index, bool) or not isinstance(refresh_index, int) or refresh_index < 0:
+        raise RefreshError(f"refresh_index: actual={refresh_index!r} expected an integer >= 0")
+    return refresh_index % PATIENT_HALVES
+
+
+def cases_of_half(metas: Iterable[Mapping[str, Any]], half: int) -> list[dict]:
+    """The case metas (cached_cases order kept) whose patient falls in ``half``: the scans one refresh runs."""
+    if half not in range(PATIENT_HALVES):
+        raise RefreshError(f"patient half: actual={half!r} expected one of {list(range(PATIENT_HALVES))}")
+    return [dict(meta) for meta in metas if patient_half(str(meta["patient_id"])) == half]
+
+
+# --------------------------------------------------------------------------
+# the request (trainer -> queue)
+# --------------------------------------------------------------------------
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise RefreshError(message)
+
+
+def _is_count(value: Any, minimum: int) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool) and value >= minimum
+
+
+def check_request(document: Mapping[str, Any], where: str) -> dict:
+    """The request document after its shape check; every refusal prints the value found and the one expected."""
+    _require(isinstance(document, Mapping), f"{where}: actual={type(document).__name__} expected a JSON object")
+    _require(document.get("schema") == REQUEST_SCHEMA,
+             f"{where}: schema actual={document.get('schema')!r} expected={REQUEST_SCHEMA!r}")
+    missing = [name for name in REQUEST_FIELDS if name not in document]
+    _require(not missing, f"{where}: fields missing actual={missing} expected=[] (fields {list(REQUEST_FIELDS)})")
+    for name in ("run_id", "arm", "checkpoint", "created_at"):
+        _require(isinstance(document[name], str) and bool(document[name]),
+                 f"{where}: {name} actual={document[name]!r} expected a non-empty string")
+    for name, minimum in (("seed", 0), ("step", 1), ("refresh_index", 0)):
+        _require(_is_count(document[name], minimum),
+                 f"{where}: {name} actual={document[name]!r} expected an integer >= {minimum}")
+    _require(isinstance(document["checkpoint_sha256"], str) and bool(SHA256_PATTERN.match(document["checkpoint_sha256"])),
+             f"{where}: checkpoint_sha256 actual={document['checkpoint_sha256']!r} expected 64 lowercase hex digits")
+    expected_half = half_for_refresh(document["refresh_index"])
+    _require(document["patient_half"] == expected_half,
+             f"{where}: patient_half actual={document['patient_half']!r} expected={expected_half} (refresh_index "
+             f"{document['refresh_index']})")
+    inside_run(Path("."), document["checkpoint"], f"{where}: checkpoint")
+    return dict(document)
+
+
+def read_request(path: Path) -> dict:
+    """The request at ``path``, checked; its name and folder must be those of its own step and run."""
+    path = Path(path)
+    _require(path.is_file(), f"refresh request: actual=no file expected a file at {path}")
+    try:
+        document = json.loads(path.read_text(encoding="utf-8"))
+    except json.JSONDecodeError as error:
+        raise RefreshError(f"{path}: not JSON: {error}") from error
+    request = check_request(document, str(path))
+    run_dir = path.parent.parent
+    _require(path.parent.name == REFRESH_DIR and path.name == request_path(run_dir, request["step"]).name,
+             f"{path}: location actual={path.parent.name}/{path.name} "
+             f"expected={REFRESH_DIR}/{request_path(run_dir, request['step']).name}")
+    _require(request["run_id"] in run_names(run_dir),
+             f"{path}: run_id actual={request['run_id']!r} expected one of {run_names(run_dir)} (its run directory)")
+    return request
+
+
+def request_run_dir(path: Path) -> Path:
+    """The training run directory of the request at ``path`` (``<run>/refresh/request-<S>.json``)."""
+    return Path(path).parent.parent
+
+
+def write_request(run_dir: Path, *, arm: str, seed: int, step: int, refresh_index: int,
+                  checkpoint: str | None = None) -> Path:
+    """Write ``<run>/refresh/request-<step>.json`` for the checkpoint the trainer kept for this refresh (default
+    refresh_checkpoint_relpath(step); it must exist: its sha256 is recorded).  The patient half follows from
+    ``refresh_index`` (half_for_refresh).  Written atomically and exclusively; a second call for the same step with the
+    same request returns the existing file, a different request for that step is refused with both values."""
+    run_dir = Path(run_dir)
+    relative = refresh_checkpoint_relpath(step) if checkpoint is None else str(checkpoint)
+    file = inside_run(run_dir, relative, "refresh checkpoint")
+    _require(file.is_file(), f"refresh checkpoint: actual=no file expected a file at {file}")
+    document = check_request({
+        "schema": REQUEST_SCHEMA, "run_id": Path(run_dir).absolute().name, "arm": str(arm), "seed": int(seed),
+        "step": int(step), "refresh_index": int(refresh_index), "checkpoint": relative,
+        "checkpoint_sha256": sha256_file(file), "patient_half": half_for_refresh(int(refresh_index)),
+        "created_at": utc_now()}, f"refresh request of step {step}")
+    target = request_path(run_dir, step)
+    if target.exists():
+        existing = read_request(target)
+        differing = {name: {"existing": existing.get(name), "new": document[name]}
+                     for name in REQUEST_IDENTITY_FIELDS if existing.get(name) != document[name]}
+        _require(not differing, f"{target} already asks for another refresh: {differing}")
+        return target
+    write_json_atomic(target, document, indent=2, sort_keys=True, ensure_ascii=True, exclusive=True)
+    return target
+
+
+def pending_request(run_dir: Path) -> Path | None:
+    """The request of ``run_dir`` that has no completion record yet, or None.  The trainer stops at the first refresh
+    step it has no record for, so at most one request can be pending; two or more are refused with their steps."""
+    folder = refresh_dir(run_dir)
+    if not folder.is_dir():
+        return None
+    steps = sorted(int(match.group(1)) for match in (REQUEST_FILE_PATTERN.match(path.name)
+                                                    for path in folder.iterdir()) if match)
+    pending = [step for step in steps if not record_path(run_dir, step).exists()]
+    _require(len(pending) <= 1, f"{folder}: requests without a completion record actual={pending} expected at most one")
+    return request_path(run_dir, pending[0]) if pending else None
+
+
+# --------------------------------------------------------------------------
+# the mid-run checkpoint the request names
+# --------------------------------------------------------------------------
+def load_refresh_checkpoint(request: Mapping[str, Any], run_dir: Path, resolved: Mapping) -> dict:
+    """Admit exactly the checkpoint the request names: the file's sha256 is the request's, the payload is a SIRB
+    checkpoint of the request's arm and seed (and arm spec, so the rollout network is the trained one) at the request's
+    step, which lies inside this recipe's run of that arm.  No final-step rule: the model of THAT moment is wanted.
+    Returns ``{"payload", "path", "sha256"}``; every refusal prints both compared values."""
+    import torch  # noqa: PLC0415  (the queue's command line never loads a checkpoint)
+
+    from common.petct_sirb_checkpoint import (  # noqa: PLC0415
+        CHECKPOINT_SCHEMA, IDENTITY_ARM_SPEC, arm_spec_record, make_run_plan)
+
+    request = check_request(request, "refresh request")
+    run_dir = Path(run_dir)
+    _require(request["run_id"] in run_names(run_dir),
+             f"refresh request run_id actual={request['run_id']!r} expected one of {run_names(run_dir)}")
+    path = inside_run(run_dir, request["checkpoint"], "refresh checkpoint")
+    actual = sha256_file(path) if path.is_file() else None
+    _require(actual == request["checkpoint_sha256"],
+             f"refresh checkpoint {path}: sha256 actual={actual} expected={request['checkpoint_sha256']} (the request's)")
+    payload = torch.load(path, map_location="cpu", weights_only=False)
+    _require(isinstance(payload, Mapping) and payload.get("schema") == CHECKPOINT_SCHEMA,
+             f"refresh checkpoint {path}: schema actual={payload.get('schema') if isinstance(payload, Mapping) else None!r}"
+             f" expected={CHECKPOINT_SCHEMA!r}")
+    identity = payload.get("identity") or {}
+    arm, seed, step = request["arm"], int(request["seed"]), int(request["step"])
+    for key, value in (("arm_id", arm), ("seed", seed), (IDENTITY_ARM_SPEC, arm_spec_record(arm))):
+        _require(identity.get(key) == value,
+                 f"refresh checkpoint {path}: {key} actual={identity.get(key)!r} expected={value!r}")
+    _require(int(payload.get("step", -1)) == step,
+             f"refresh checkpoint {path}: step actual={payload.get('step')!r} expected={step} (the request's)")
+    total = make_run_plan(resolved, arm, seed).total_steps
+    _require(identity.get("total_steps") == total and step < total,
+             f"refresh checkpoint {path}: total_steps actual={identity.get('total_steps')!r} expected={total} with "
+             f"step {step} < total (the run plan of arm {arm} seed {seed} under this recipe)")
+    return {"payload": payload, "path": path, "sha256": actual}
+
+
+def refresh_checkpoint_system(request: Mapping[str, Any], run_dir: Path, resolved: Mapping, *, device: str,
+                              numerics: str, tile_batch: int) -> dict[str, Any]:
+    """The rollout system of the refresh checkpoint, in the shape of petct_sirb_evaluation.load_checkpoint_system (the
+    same four steps: admit, build_sirb_network, load_state_dict(strict=True), model_predictor), with the admission of
+    :func:`load_refresh_checkpoint` instead of the final-checkpoint rule.  The frozen predictor: no test-time flip."""
+    import torch  # noqa: PLC0415
+
+    from common.petct_sirb_inference import TTA_FLIP_NONE  # noqa: PLC0415
+    from common.petct_sirb_network import NUMERICS_PROFILES, build_sirb_network  # noqa: PLC0415
+    from common.petct_sirb_rollout import model_predictor  # noqa: PLC0415
+
+    _require(numerics in NUMERICS_PROFILES, f"numerics: actual={numerics!r} allowed={tuple(NUMERICS_PROFILES)}")
+    started = time.perf_counter()
+    admitted = load_refresh_checkpoint(request, run_dir, resolved)
+    arm, seed = str(request["arm"]), int(request["seed"])
+    model = build_sirb_network(resolved, arm, seed)
+    model.load_state_dict(admitted["payload"]["model"], strict=True)
+    model.to(torch.device(device)).eval()
+    predictor = model_predictor(model, resolved, device=torch.device(device), numerics=numerics,
+                                tile_batch=tile_batch, checkpoint_sha256=admitted["sha256"])
+    return {"predictor": predictor, "model_id": arm, "seed": seed, "checkpoint_sha256": admitted["sha256"],
+            "checkpoint_payload": {key: admitted["payload"][key] for key in ("identity", "step")},
+            "model_load_seconds": time.perf_counter() - started, "numerics": numerics,
+            "tile_batch": int(tile_batch), "device": device, "tta_flip": TTA_FLIP_NONE}
+
+
+def rollout_request_record(request_file: Path, request: Mapping[str, Any]) -> dict:
+    """What the rollout receipt records of the request it ran (ROLLOUT_REQUEST_KEY; its sha256 under
+    ROLLOUT_REQUEST_SHA256_KEY binds the rollout to the request)."""
+    return {"path": str(request_file), "sha256": sha256_file(request_file), "run_id": request["run_id"],
+            "step": request["step"], "refresh_index": request["refresh_index"],
+            "patient_half": request["patient_half"], "checkpoint": request["checkpoint"],
+            "checkpoint_sha256": request["checkpoint_sha256"]}
+
+
+# --------------------------------------------------------------------------
+# the completion record (queue -> trainer)
+# --------------------------------------------------------------------------
+def _read_json(path: Path, what: str) -> dict:
+    _require(Path(path).is_file(), f"{what}: actual=no file expected a file at {path}")
+    try:
+        return json.loads(Path(path).read_text(encoding="utf-8"))
+    except json.JSONDecodeError as error:
+        raise RefreshError(f"{what} {path}: not JSON: {error}") from error
+
+
+def write_record(run_dir: Path, step: int) -> Path:
+    """Write ``<run>/refresh/refresh-<step>.json`` once the rollout and the pool of that refresh exist.  Bound by file
+    identity only: the rollout receipt names the request's sha256, the pool summary names the rollout receipt's
+    sha256 as its one source and the pairs file's sha256; every rollout patient lies in the request's half; the pool
+    holds pairs.  Exclusive: a refresh is recorded once."""
+    run_dir, step = Path(run_dir), int(step)
+    request_file = request_path(run_dir, step)
+    request = read_request(request_file)
+    request_sha = sha256_file(request_file)
+    rollout = rollout_dir(run_dir, step)
+    manifest_file = rollout / ROLLOUT_MANIFEST_FILE
+    manifest = _read_json(manifest_file, "refresh rollout receipt")
+    _require(manifest.get(ROLLOUT_REQUEST_SHA256_KEY) == request_sha,
+             f"{manifest_file}: {ROLLOUT_REQUEST_SHA256_KEY} actual={manifest.get(ROLLOUT_REQUEST_SHA256_KEY)!r} "
+             f"expected={request_sha} (sha256 of {request_file})")
+    manifest_sha = sha256_file(manifest_file)
+    trajectories = read_jsonl(rollout / jsonl_file(ROLLOUT_TRAJECTORY_RECORDS))
+    patients = sorted({str(row["patient_id"]) for row in trajectories})
+    scans = sorted({str(row["scan_id"]) for row in trajectories})
+    other_half = [patient for patient in patients if patient_half(patient) != request["patient_half"]]
+    _require(not other_half, f"{rollout}: patients outside half {request['patient_half']} actual={other_half[:5]} "
+                             f"({len(other_half)}) expected=[]")
+    evaluated = sorted(str(case) for case in manifest.get("evaluated_cases", []))
+    _require(scans == evaluated, f"{rollout}: scans of trajectories.jsonl actual={len(scans)} expected the receipt's "
+                                 f"evaluated_cases={len(evaluated)}")
+    pool = pool_dir(run_dir, step)
+    summary = _read_json(pool / BANK_SUMMARY_FILE, "refresh pool summary")
+    sources = [source.get("rollout_manifest_sha256") for source in summary.get("sources", [])]
+    _require(sources == [manifest_sha], f"{pool / BANK_SUMMARY_FILE}: sources' rollout_manifest_sha256 actual={sources} "
+                                        f"expected={[manifest_sha]} (sha256 of {manifest_file})")
+    pairs_file = pool / PAIRS_FILE
+    pairs_sha = sha256_file(pairs_file) if pairs_file.is_file() else None
+    _require(pairs_sha is not None and summary.get("pairs_manifest_sha256") == pairs_sha,
+             f"{pairs_file}: sha256 actual={pairs_sha} expected={summary.get('pairs_manifest_sha256')!r} (the pool "
+             f"summary's pairs_manifest_sha256)")
+    n_pairs = len(read_jsonl(pairs_file))
+    _require(n_pairs > 0, f"{pairs_file}: pairs actual=0 expected>0 (a refresh pool the trainer could not draw from)")
+    record = {"schema": RECORD_SCHEMA, "step": step, "refresh_index": request["refresh_index"],
+              "patient_half": request["patient_half"], "request_sha256": request_sha,
+              "checkpoint_sha256": request["checkpoint_sha256"], "rollout_dir": relative_to_run(run_dir, rollout),
+              "rollout_manifest_sha256": manifest_sha, "pool_dir": relative_to_run(run_dir, pool),
+              "pool_pairs_sha256": pairs_sha, "n_pairs": n_pairs, "n_states": len(read_jsonl(pool / EPISODES_FILE)),
+              "n_scans": len(scans), "n_patients": len(patients),
+              "failed_trajectories": int(manifest.get("failed_trajectories") or 0), "created_at": utc_now()}
+    target = record_path(run_dir, step)
+    write_json_atomic(target, record, indent=2, sort_keys=True, ensure_ascii=True, exclusive=True)
+    return target
+
+
+@dataclass(frozen=True)
+class RefreshPool:
+    """A completed refresh as the trainer reads it: the pool folder (the manifest root its pair paths are relative to)
+    and its pairs file, checked against the record."""
+    step: int
+    refresh_index: int
+    patient_half: int
+    pool_dir: Path
+    pairs_path: Path
+    pairs_sha256: str
+    n_pairs: int
+    record: Mapping[str, Any]
+
+
+def check_record(document: Mapping[str, Any], where: str, step: int) -> dict:
+    _require(isinstance(document, Mapping), f"{where}: actual={type(document).__name__} expected a JSON object")
+    _require(document.get("schema") == RECORD_SCHEMA,
+             f"{where}: schema actual={document.get('schema')!r} expected={RECORD_SCHEMA!r}")
+    missing = [name for name in RECORD_FIELDS if name not in document]
+    _require(not missing, f"{where}: fields missing actual={missing} expected=[]")
+    _require(document["step"] == step, f"{where}: step actual={document['step']!r} expected={step} (its file name)")
+    return dict(document)
+
+
+def read_records(run_dir: Path, up_to_step: int) -> list[RefreshPool]:
+    """Every completed refresh of ``run_dir`` at a step <= ``up_to_step``, by step.  Each pool's pairs file must have
+    the sha256 its record holds (refused with both values): the trainer draws from exactly the states recorded."""
+    folder = refresh_dir(run_dir)
+    if not folder.is_dir():
+        return []
+    pools = []
+    for path in sorted(folder.iterdir()):
+        match = RECORD_FILE_PATTERN.match(path.name)
+        if match is None or int(match.group(1)) > int(up_to_step):
+            continue
+        step = int(match.group(1))
+        record = check_record(_read_json(path, "refresh completion record"), str(path), step)
+        pool = inside_run(run_dir, record["pool_dir"], f"{path}: pool_dir")
+        pairs = pool / PAIRS_FILE
+        actual = sha256_file(pairs) if pairs.is_file() else None
+        _require(actual == record["pool_pairs_sha256"],
+                 f"{pairs}: sha256 actual={actual} expected={record['pool_pairs_sha256']} (completion record {path})")
+        pools.append(RefreshPool(step=step, refresh_index=int(record["refresh_index"]),
+                                 patient_half=int(record["patient_half"]), pool_dir=pool, pairs_path=pairs,
+                                 pairs_sha256=actual, n_pairs=int(record["n_pairs"]), record=record))
+    return sorted(pools, key=lambda pool: pool.step)
+
+
+# --------------------------------------------------------------------------
+# command line of the queue
+# --------------------------------------------------------------------------
+def pending_lines(run_dir: Path) -> list[str]:
+    """KEY=VALUE lines of the pending request of ``run_dir`` (nothing when none): what the queue runs next.  Paths with
+    forward slashes, which bash and Python read alike on every platform."""
+    path = pending_request(run_dir)
+    if path is None:
+        return []
+    request = read_request(path)
+    step = request["step"]
+    values = {"request": path.as_posix(), "step": step, "refresh_index": request["refresh_index"],
+              "patient_half": request["patient_half"], "arm": request["arm"], "seed": request["seed"],
+              "rollout_dir": rollout_dir(run_dir, step).as_posix(), "pool_dir": pool_dir(run_dir, step).as_posix(),
+              "record": record_path(run_dir, step).as_posix()}
+    return [f"{key}={value}" for key, value in values.items()]
+
+
+def _emit(lines: Sequence[str]) -> None:
+    """UTF-8 and LF whatever the platform (Windows text mode would add a CR to every line the queue reads)."""
+    sys.stdout.buffer.write("".join(f"{line}\n" for line in lines).encode("utf-8"))
+    sys.stdout.flush()
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    commands = parser.add_subparsers(dest="command", required=True)
+    pending = commands.add_parser("pending", help="print the pending request of a run as KEY=VALUE lines")
+    pending.add_argument("--run-dir", required=True, type=Path)
+    record = commands.add_parser("record", help="write the completion record of a refresh")
+    record.add_argument("--run-dir", required=True, type=Path)
+    record.add_argument("--step", required=True, type=int)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    try:
+        if args.command == "pending":
+            _emit(pending_lines(args.run_dir))
+        else:
+            _emit([f"record={write_record(args.run_dir, args.step).as_posix()}"])
+    except (RefreshError, FileExistsError, OSError, KeyError, ValueError) as reason:
+        print(f"{LOG_PREFIX} REFUSED: {type(reason).__name__}: {reason}", file=sys.stderr)
+        return EXIT_REFUSED
+    return EXIT_OK
+
+
+if __name__ == "__main__":
+    sys.exit(main())
