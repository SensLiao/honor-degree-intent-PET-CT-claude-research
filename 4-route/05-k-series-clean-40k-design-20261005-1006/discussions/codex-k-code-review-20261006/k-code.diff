+def write_fake_outputs(run: Path, step: int, patients: list[str], *, pairs: int = 3) -> None:
+    """A rollout and a pool of the refresh at ``step`` with only the files the completion record reads."""
+    request_file = refresh.request_path(run, step)
+    rollout = refresh.rollout_dir(run, step)
+    rollout.mkdir(parents=True)
+    scans = [f"{patient}_scan{index}" for patient in patients for index in (0, 1)]
+    with (rollout / jsonl_file(ROLLOUT_TRAJECTORY_RECORDS)).open("w", encoding="utf-8", newline="\n") as stream:
+        for scan in scans:
+            stream.write(json.dumps({"patient_id": scan.split("_scan")[0], "scan_id": scan}) + "\n")
+    (rollout / ROLLOUT_MANIFEST_FILE).write_text(json.dumps({
+        refresh.ROLLOUT_REQUEST_SHA256_KEY: sha256_file(request_file), "evaluated_cases": scans,
+        "failed_trajectories": 0}), encoding="utf-8")
+    pool = refresh.pool_dir(run, step)
+    pool.mkdir(parents=True)
+    (pool / PAIRS_FILE).write_text("".join(f'{{"pair": {index}}}\n' for index in range(pairs)), encoding="utf-8")
+    (pool / EPISODES_FILE).write_text('{"episode": 0}\n{"episode": 1}\n', encoding="utf-8")
+    (pool / BANK_SUMMARY_FILE).write_text(json.dumps({
+        "sources": [{"rollout_manifest_sha256": sha256_file(rollout / ROLLOUT_MANIFEST_FILE)}],
+        "pairs_manifest_sha256": sha256_file(pool / PAIRS_FILE)}), encoding="utf-8")
+
