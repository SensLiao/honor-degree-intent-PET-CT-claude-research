+def plan_file_value(resolved: Mapping, key: str) -> Any:
+    """The PLAN FILE's value of a dotted plan key such as ``training.checkpoint_interval_steps``: a recipe that overrides
+    the key (the CPU smoke config) keeps the plan value in ``overrides.changed_plan_keys``; otherwise the resolved value
+    is the plan's."""
+    changed = resolved.get("overrides", {}).get("changed_plan_keys", {})
+    if key in changed:
+        return changed[key]["plan"]
+    node: Any = resolved["science"]
+    for part in key.split("."):
+        node = node[part]
+    return node
+
+
