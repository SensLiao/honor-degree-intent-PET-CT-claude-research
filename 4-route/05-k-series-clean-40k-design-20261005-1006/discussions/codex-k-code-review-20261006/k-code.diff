+"""K2 online state refresh of SIRB-Net: request, completion record, patient halves, mid-run checkpoint admission.
+
+Reading name: 训练-指代绑定在线刷新状态池.  Plan: protocols/petct-sirb-v2-referent-scope-plan-20261003/
+experiment-schedule-gpus.md part 二 "K2 刷新的固定做法" (D-2026-10-05-01): two refreshes, at steps 10,000 and 25,000;
+each runs the checkpoint of that moment with the 0.5 executor, one pre-assigned style per scan and all five rounds on
+HALF of the TRAIN patients (the first refresh one half by a hash of the patient id, the second the other half; all
+scans of a patient together); T/O/P are recomputed from TRAIN truth on the new states; the new states are MERGED
+into the pool, never replace it; the optimiser still takes 40k steps (the rollout is no step).
+
+One file per hand-over, all in ``<run>/refresh/``; the names are spelled here (the bash queue spells only the folder
+name, which tests/test_petct_sirb_refresh.py keeps equal to REFRESH_DIR, and asks this file's command line for the
+rest)::
+
+    trainer at step S   checkpoints/refresh_step_<S:07d>.pt, then request-<S>.json (write_request);
+                        exits REFRESH_EXIT_CODE
+    queue               rollout-<S>/   eval_petct_editor_sirb_rollout.py --refresh-request .../request-<S>.json
+                                       (refresh_checkpoint_system admits the checkpoint; cases_of_half picks the scans)
+                        pool-<S>/      gen_petct_dataset_sirb_selfstate_pool.py --rollout-dir=.../rollout-<S> --rows-dir=-
+                        refresh-<S>.json   the completion record (write_record); then the training again, resumed
+    trainer on start    read_records(run_dir, up_to_step): every completed refresh up to its step, each pool's pairs
+                        file checked against its record
+
+Command line (the queue's; one ``--name value`` per option)::
+
+    petct_sirb_refresh.py pending --run-dir RUN    KEY=VALUE lines of the pending request, nothing when none
+    petct_sirb_refresh.py record --run-dir RUN --step S    writes refresh-<S>.json, prints record=<path>
+
+This module reads no label and no image (the rollout and the pool builder do).  The torch-dependent parts are imported
+inside the two functions that load a checkpoint, so the queue's command line starts in a fraction of a second.  Lane:
+training orchestration, never deployment (tests/test_petct_sirb_inference_rollout.py classifies it).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import sys
+import time
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path, PurePosixPath
+from typing import Any, Iterable, Mapping, Sequence
+
+if __name__ == "__main__":          # run as the queue's command line: make ``common`` importable, as every entry does
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from common.petct_sirb_config import sha256_file  # noqa: E402
+from common.petct_sirb_io import read_jsonl, write_json_atomic  # noqa: E402
+from common.petct_sirb_layout import (  # noqa: E402
+    BANK_SUMMARY_FILE,
+    EPISODES_FILE,
+    PAIRS_FILE,
+    ROLLOUT_MANIFEST_FILE,
+    ROLLOUT_TRAJECTORY_RECORDS,
+    jsonl_file,
+)
+
+# --------------------------------------------------------------------------
+# names and numbers
+# --------------------------------------------------------------------------
+#: Exit code of a trainer that stopped at a refresh step and asks for a refresh.  It is outside every code that already
+#: means something: the trainer's registered failures (registry FAILURE_OUTCOMES: 1-5, 20-22), argparse 2, a signal
+#: 128+n, and the launch include's sysexits codes 64-69 and 75 (scripts/orchestration/petct_editor_sirb_launch_common.sh,
+#: which defines SIRB_EXIT_REFRESH_REQUESTED with this same number; tests/test_petct_sirb_refresh.py keeps them equal).
+REFRESH_EXIT_CODE = 76
