+def check_k_manifest(document: dict, arm: str, *, status: str, steps: int) -> None:
+    assert (document["arm"], document["status"], document["optimizer_steps"]) == (arm, status, steps)
+    assert document["parent"] == {} and document["sequence_offset"] == 0 and not document["smoke_truncated"]
+    assert document["pools"]["on_policy_pairs"] > 0                          # it reads the state pool ...
+    assert document["identity"][IDENTITY_ARM_SPEC] == arm_spec_record(arm)    # ... from scratch, under its record
+    assert document["plan"]["continuation"] is False and document["plan"]["state_base_warmup"] == 2
+    assert document["experiment"]["source"] == EXPERIMENTS[arm].source
+    assert document["experiment"]["document"]["arm_id"] == arm and document["data_recipe"] == \
+        data_recipe_for_arm(arm).record()
+    assert not any(attempt["status"] == "running" for attempt in document["attempts"])
