+def recipe_step(resolved: Mapping, formal_step: int, *, interval: int | None = None) -> int:
+    """An optimizer step of the formal recipe (the plan's 40,000-step run) on this recipe's scale: formal step x this
+    recipe's formal step count / the plan file's, halves rounded up, at least 1; with ``interval`` rounded to the nearest
+    positive multiple of it instead.  The formal recipe maps every step onto itself; the CPU smoke config (12 of 40,000
+    steps, a checkpoint every 4) maps 1,000 to 1 and, at its checkpoint interval, 10,000 to 4 and 25,000 to 8, so no
+    smoke run trains thousands of CPU steps to reach one (the 2026-09-17 incident; like continuation_budget)."""
+    registered = int(resolved["science"]["training"]["formal_optimizer_steps_proposed"])
+    planned = int(plan_file_value(resolved, FORMAL_STEPS_KEY))
+    scaled = int(formal_step) * registered / planned
+    if interval is None:
+        return max(1, int(math.floor(scaled + 0.5)))
+    return max(int(interval), int(interval) * int(math.floor(scaled / int(interval) + 0.5)))
+
