+def test_a_resume_reads_the_calibration_back_and_one_from_before_it_calibrates_on_reaching_it(disk, resolved, tmp_path,
+                                                                                            monkeypatch):
+    monkeypatch.setattr(training_module, "ALIGNMENT_UNITS_PER_TERM", 2)
+    calls = []
+    real = training_module.calibrate_dice_gain
+
+    def counted(*args, **kwargs):
+        calls.append(kwargs["step"])
+        return real(*args, **kwargs)
+
+    monkeypatch.setattr(training_module, "calibrate_dice_gain", counted)
+    straight = run_k(disk, resolved, "INTENT_FULL", tmp_path / "straight")
+    assert calls == [SMOKE_CALIBRATION] and straight["status"] == "completed"
+    reference = torch.load(tmp_path / "straight" / "checkpoints" / "final.pt", weights_only=False)
+    # cut at step 0: the checkpoint is "pending"; the resume calibrates on reaching the step, once
+    with pytest.raises(StopIteration):
+        run_k(disk, resolved, "INTENT_FULL", tmp_path / "early", stop_at=0)
+    early = torch.load(tmp_path / "early" / "checkpoints" / "latest.pt", weights_only=False)
+    assert early["step"] == 0 and early[LOSS_ALIGNMENT_KEY]["state"] == ALIGNMENT_PENDING
+    calls.clear()
+    resumed = run_k(disk, resolved, "INTENT_FULL", tmp_path / "early", resume=True)
+    assert calls == [SMOKE_CALIBRATION] and resumed[LOSS_ALIGNMENT_KEY] == straight[LOSS_ALIGNMENT_KEY]
+    # cut at step 4: the checkpoint is "calibrated"; the resume reads it back and never calibrates again
+    with pytest.raises(StopIteration):
+        run_k(disk, resolved, "INTENT_FULL", tmp_path / "late", stop_at=8)
+    late = torch.load(tmp_path / "late" / "checkpoints" / "latest.pt", weights_only=False)
+    assert late["step"] == 4 and late[LOSS_ALIGNMENT_KEY] == straight[LOSS_ALIGNMENT_KEY]
+    calls.clear()
+    resumed_late = run_k(disk, resolved, "INTENT_FULL", tmp_path / "late", resume=True)
+    assert calls == [] and resumed_late[LOSS_ALIGNMENT_KEY] == straight[LOSS_ALIGNMENT_KEY]
+    for name in ("early", "late"):
+        weights = torch.load(tmp_path / name / "checkpoints" / "final.pt", weights_only=False)["model"]
+        for key, value in reference["model"].items():
+            torch.testing.assert_close(weights[key], value, rtol=1e-5, atol=1e-6)
+    # a checkpoint whose record contradicts its step is refused, with both values
+    payload = torch.load(tmp_path / "late" / "checkpoints" / "latest.pt", weights_only=False)
+    payload[LOSS_ALIGNMENT_KEY] = dict(payload[LOSS_ALIGNMENT_KEY], state=ALIGNMENT_PENDING)
+    torch.save(payload, tmp_path / "late" / "checkpoints" / "latest.pt")
+    with pytest.raises(ResumeMismatchError, match=r"loss_alignment.state: actual='pending' expected='calibrated'"):
+        run_k(disk, resolved, "INTENT_FULL", tmp_path / "late", resume=True)
+
