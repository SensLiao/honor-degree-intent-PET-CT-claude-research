+def run_k(disk, resolved, arm, run_dir, *, stop_at=None, resume=False, refresh_states=(), share=None, **kwargs):
+    """The trainer on the K dataset from the micro index of ``run_dir``'s checkpoint; ``stop_at`` (micro index) cuts
+    the loader there (the run then fails with StopIteration, leaving its last checkpoint)."""
+    plan = make_run_plan(resolved, arm, SEED)
+    start = training_module.micro_index_start(run_dir, plan.accumulation) if resume else 0
+    data = k_dataset(disk, resolved, arm, refresh_states=refresh_states, share=share)
+    end = len(data) if stop_at is None else stop_at
+    return train(resolved=resolved, arm_id=arm, seed=SEED, manifest=disk.manifest,
+                 loader=(data[i] for i in range(start, end)), run_dir=run_dir, device=CPU, resume=resume,
+                 probes=probe_signature([data[0]]), alignment_units=k_dataset(disk, resolved, arm),
+                 refresh_states=refresh_states, **kwargs)
