+def test_the_calibration_sets_only_the_dice_gain_from_the_target_dice_gradient(disk, resolved, monkeypatch):
+    monkeypatch.setattr(training_module, "ALIGNMENT_UNITS_PER_TERM", 2)
+    units = k_dataset(disk, resolved, "INTENT_FULL")
+    model = build_sirb_network(resolved, "INTENT_FULL", SEED)
+    parts = intent_parts(model.arm)
+    schedule = run_schedule(resolved, "INTENT_FULL")
+    pending = pending_dice_gain_record(parts, resolved, "INTENT_FULL", schedule)
+    assert pending["state"] == ALIGNMENT_PENDING and set(pending["multipliers"].values()) == {1.0}
+    record = calibrate_dice_gain(model, units, resolved, device=CPU, state_weight=0.0, arm_id="INTENT_FULL",
+                                 record=pending, step=1)
+    used = record["units"][TERM_DICE_GAIN]
+    assert len(used) == 2 and used == sorted(used) and record["state"] == ALIGNMENT_CALIBRATED
+    weight = training_module.loss_weights(resolved)[DICE_REFERENCE_TERM]
+    trainable = [parameter for parameter in model.parameters() if parameter.requires_grad]
+    reference, gain = [], []
+    for index in used:                                  # the formula, recomputed term by term
+        unit = units[index]
+        _, loss = unit_loss(model, unit.inputs, unit.labels, resolved, 0.0)
+        norms = term_gradient_norms(loss, trainable)
+        reference.append(weight * float(norms["grad_norm_" + BASE_PREFIX + DICE_REFERENCE_TERM]))
+        gain.append(float(norms["grad_norm_" + INTENT_PREFIX + TERM_DICE_GAIN]))
+    assert record["multipliers"][TERM_DICE_GAIN] == pytest.approx(np.mean(reference) / np.mean(gain), rel=1e-6)
+    assert {name: value for name, value in record["multipliers"].items() if name != TERM_DICE_GAIN} == \
+        {name: 1.0 for name in parts.terms if name != TERM_DICE_GAIN}
+    assert not any(parameter.grad is not None for parameter in model.parameters())    # nothing accumulated
