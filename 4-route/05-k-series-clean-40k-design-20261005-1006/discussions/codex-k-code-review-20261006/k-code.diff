+def rewrite_json(path: Path, changes: dict) -> None:
+    document = json.loads(path.read_text(encoding="utf-8"))
+    document.update(changes)
+    path.write_text(json.dumps(document), encoding="utf-8")
+
+
+def append_line(path: Path, row: dict) -> None:
+    with path.open("a", encoding="utf-8", newline="\n") as stream:
+        stream.write(json.dumps(row) + "\n")
+
+
+def write_empty_pool(run: Path) -> None:
+    pool = refresh.pool_dir(run, STEP)
+    (pool / PAIRS_FILE).write_text("", encoding="utf-8")
+    rewrite_json(pool / BANK_SUMMARY_FILE, {"pairs_manifest_sha256": sha256_file(pool / PAIRS_FILE)})
+
