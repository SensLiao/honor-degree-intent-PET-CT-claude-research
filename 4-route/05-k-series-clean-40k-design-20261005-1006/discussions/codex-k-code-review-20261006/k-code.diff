+def k_dataset(disk, resolved, arm, *, total=24, refresh_states=(), share=None):
+    return PairUnitDataset(manifest=disk.manifest, store=disk.store, resolved=resolved, seed=SEED,
+                           total_micro_batches=total, pair_loader=load_training_pair_npz, manifest_root=disk.offline.parent,
+                           sequence_offset=0, recipe=data_recipe_for_arm(arm), refresh_states=refresh_states,
+                           new_state_share=share)
