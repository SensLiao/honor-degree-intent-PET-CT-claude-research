+def check_multipliers_reached_the_loss(records: list[dict], alignment: dict) -> None:
+    """Every logged total is base + state weight x state + sum of multiplier x group-B term, with multiplier 1 before
+    the calibration step and the recorded multipliers from it on (the metrics are per-step means: linear)."""
+    for record in records:
+        multipliers = alignment["multipliers"] if record["step"] > alignment["calibration_step"] else \
+            {name: 1.0 for name in alignment["multipliers"]}
+        expected = record["base_total"] + record["state_weight"] * record["state_total"] + sum(
+            multipliers[name] * record[INTENT_PREFIX + name] for name in multipliers)
+        assert record["total"] == pytest.approx(expected, rel=1e-5, abs=1e-6), (record["step"], record["total"], expected)
+
