+def write_refresh_pool(world, run_dir: Path, step: int) -> Path:
+    """What the queue leaves for a completed refresh at ``step``: the pool folder (fresh history pairs of the phantom
+    states as the refresh rollout's states) and the completion record (petct_sirb_refresh's schema; the rollout fields
+    are not read by the trainer)."""
+    pool = refresh.pool_dir(run_dir, step)
+    pairs = write_bank(world, pool, kind="states", tag=f"rollout-{step}",
+                       extra_fields=lambda n: {ROW_RECOVERABLE_GAP: None, ROW_STATE_OCCURRENCES: 1})
+    request = refresh.read_request(refresh.request_path(run_dir, step))
+    record = {"schema": refresh.RECORD_SCHEMA, "step": step, "refresh_index": request["refresh_index"],
+              "patient_half": request["patient_half"],
+              "request_sha256": sha256_file(refresh.request_path(run_dir, step)),
+              "checkpoint_sha256": request["checkpoint_sha256"],
+              "rollout_dir": refresh.relative_to_run(run_dir, refresh.rollout_dir(run_dir, step)),
+              "rollout_manifest_sha256": "0" * 64, "pool_dir": refresh.relative_to_run(run_dir, pool),
+              "pool_pairs_sha256": sha256_file(pairs), "n_pairs": len(world.rows), "n_states": len(world.rows),
+              "n_scans": len(world.rows), "n_patients": len(world.rows), "failed_trajectories": 0,
+              "created_at": "2026-10-06T00:00:00+00:00"}
+    assert set(record) == set(refresh.RECORD_FIELDS)
+    path = refresh.record_path(run_dir, step)
+    path.write_bytes((json.dumps(record, indent=2, sort_keys=True) + "\n").encode("utf-8"))
+    return path
+
+
+def entry(disk, arm: str, run_dir: Path, *extra: str, workers: int = 0) -> subprocess.CompletedProcess:
+    """The REAL training entry in its own process, CUDA hidden, on the phantom files."""
+    command = [sys.executable, "-B", str(ENTRY), "--arm", arm, "--seed", str(SEED), "--run-dir", str(run_dir),
+               "--pair-manifest", str(disk.offline), "--manifest-root", str(disk.offline.parent),
+               "--onpolicy-pair-manifest", str(disk.pool), "--onpolicy-manifest-root", str(disk.pool.parent),
+               "--inputs-root", str(disk.inputs), "--labels-root", str(disk.labels), "--override-file", str(SMOKE),
+               "--device", "cpu", "--workers", str(workers), *extra]
+    return subprocess.run(command, cwd=PROJECT, capture_output=True, text=True,
+                          env=dict(os.environ, CUDA_VISIBLE_DEVICES="", PYTHONDONTWRITEBYTECODE="1"))
+
+
+def manifest_of(run_dir: Path) -> dict:
+    return json.loads((run_dir / "run_manifest.json").read_text(encoding="utf-8"))
+
+
+def metrics_of(run_dir: Path) -> list[dict]:
+    return [json.loads(line) for line in (run_dir / "metrics.jsonl").read_text(encoding="utf-8").splitlines()]
