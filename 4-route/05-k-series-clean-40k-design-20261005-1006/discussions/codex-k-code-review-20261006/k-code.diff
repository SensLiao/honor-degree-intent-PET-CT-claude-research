+def test_the_refresh_system_predicts_exactly_like_the_final_checkpoint_system(tmp_path, smoke, train_cohort):
+    """The refresh predictor mirrors load_checkpoint_system: the same weights give the same pT, bit for bit."""
+    from common.petct_sirb_cases import CaseStore  # noqa: PLC0415
+    from common.petct_sirb_checkpoint import make_run_plan  # noqa: PLC0415
+    from common.petct_sirb_evaluation import load_checkpoint_system  # noqa: PLC0415
+    from common.petct_sirb_inference import InferenceInput  # noqa: PLC0415
+    from common.petct_sirb_registry import NUMERICS_DEFAULT, SIGN_ADD, SIGN_REMOVE  # noqa: PLC0415
+
+    run = make_run(tmp_path)
+    model = save_model_checkpoint(run / refresh.refresh_checkpoint_relpath(STEP), smoke)
+    request = refresh.read_request(refresh.write_request(run, arm=ARM, seed=SEED, step=STEP, refresh_index=0))
+    final = run / "checkpoints" / "final.pt"
+    total = make_run_plan(smoke, ARM, SEED).total_steps
+    save_model_checkpoint(final, smoke, step=total, model=model)        # the same weights, as the final step
+    settings = {"device": "cpu", "numerics": NUMERICS_DEFAULT, "tile_batch": 4}
+    mid = refresh.refresh_checkpoint_system(request, run, smoke, **settings)
+    end = load_checkpoint_system(final, resolved=smoke, arm=ARM, seed=SEED, **settings)
+    assert set(mid) == set(end)
+    assert {k: mid[k] for k in ("model_id", "seed", "numerics", "tile_batch", "device", "tta_flip")} == \
+        {k: end[k] for k in ("model_id", "seed", "numerics", "tile_batch", "device", "tta_flip")}
+    assert mid["checkpoint_payload"]["step"] == STEP and end["checkpoint_payload"]["step"] == total
+    case_id = train_cohort.rows[0]["case_id"]
+    case = CaseStore(train_cohort.inputs).inputs(case_id)
+    reference = CaseStore(train_cohort.inputs, train_cohort.labels).ground_truth(case_id)
+    mask = np.asarray(case.m0) > 0
+    missed, extra = reference & ~mask, mask & ~reference
+    sign, region = (SIGN_ADD, missed) if missed.sum() >= extra.sum() else (SIGN_REMOVE, extra)
+    stroke = np.zeros_like(mask)
+    stroke[tuple(np.argwhere(region)[:3].T)] = True
+    nothing = np.zeros_like(mask)
+    item = InferenceInput(case, mask, stroke, sign, nothing, nothing.copy())
+    first, second = mid["predictor"](item), end["predictor"](item)
+    assert np.array_equal(first.target_prob, second.target_prob)
+
