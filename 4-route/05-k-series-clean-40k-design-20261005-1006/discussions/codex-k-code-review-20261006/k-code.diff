+@pytest.fixture(scope="module")
+def disk(world, tmp_path_factory):
+    """The phantom world as the entry sees it on a server: an offline bank and a gap-weighted state pool of real
+    pair files.  ``pool_rows`` gives every state a positive recoverable gap (B4 refuses a pool without one)."""
+    root = tmp_path_factory.mktemp("k_disk")
+    offline = write_bank(world, root / "offline", kind="offline", tag="offline")
+    pool = write_bank(world, root / "statepool", kind="states", tag="teacher",
+                      extra_fields=lambda n: {ROW_RECOVERABLE_GAP: 0.05 * (n + 1), ROW_STATE_OCCURRENCES: 1})
+    manifest = load_pair_manifest(offline, extra=[(pool, pool.parent)])
+    return SimpleNamespace(root=root, offline=offline, pool=pool, manifest=manifest, inputs=world.root / "inputs",
+                           labels=world.root / "labels", store=world.store)
