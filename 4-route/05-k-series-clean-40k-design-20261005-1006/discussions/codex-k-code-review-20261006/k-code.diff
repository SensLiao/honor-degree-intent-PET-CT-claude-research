+def strict_json_loads(text: str, *, error: type[Exception] = ValueError) -> Any:
+    """``json.loads`` for a configuration file: a key given twice in one object, or a non-finite constant (NaN,
+    Infinity), raises ``error`` instead of being silently kept or parsed.  The one implementation of that rule:
+    petct_sirb_config reads the plan, implementation, override and runtime files with it (error SirbConfigError), and
+    petct_sirb_experiments the experiment files, which it reads while the registry is being imported, before
+    petct_sirb_config can be imported."""
+
+    def unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+        document: dict[str, Any] = {}
+        for key, value in pairs:
+            if key in document:
+                raise error(f"duplicate JSON key: {key}")
+            document[key] = value
+        return document
+
+    def reject(token: str) -> float:
+        raise error(f"non-finite JSON constant is not allowed: {token}")
+
+    return json.loads(text, object_pairs_hook=unique, parse_constant=reject)
