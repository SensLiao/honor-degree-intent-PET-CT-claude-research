+def pair_record(source, row: dict, *, state_source: str, history: bool):
+    """A stored pair of the phantom world's pair ``source`` (the dataset test's fabricated pair, or its history
+    pair): real PairRecord fields; the counts are not read by a training unit."""
+    mask_before, mask_after = np.asarray(source.mask_before, bool), np.asarray(source.mask_after, bool)
+    fields = dict(pair_id=row["pair_id"], episode_id=row["episode_id"], case_id=row["case_id"],
+                  patient_id=row["patient_id"], split="train", state_source=state_source, pair_type=row["pair_type"],
+                  synthetic=False, mask_before=mask_before, mask_after=mask_after,
+                  intervention=mask_before ^ mask_after, sign=source.sign, stroke=np.asarray(source.stroke, bool),
+                  history_positive=np.asarray(source.history_positive, bool),
+                  history_negative=np.asarray(source.history_negative, bool),
+                  transition_counts={key: 0 for key in TRANSITION_COUNT_KEYS}, anchor_status_before=ANCHOR_VALID,
+                  anchor_status_after=ANCHOR_VALID, attempts=1, fallback_from=None, status=STATUS_OK)
+    if not history:
+        return PairRecord(**fields)
+    return HistoryPairRecord(**fields, previous_delta=np.asarray(source.previous_delta, np.int8),
+                             interaction_flags=dict(source.interaction_flags),
+                             previous_stroke=np.asarray(source.previous_stroke, bool))
+
+
+def write_bank(world, root: Path, *, kind: str, tag: str, extra_fields=None) -> Path:
+    """``root/pairs.jsonl`` and one npz per phantom case.  kind "offline": the world's offline pairs; kind "states":
+    its history pairs as states a model induced (state pool rows with a recoverable gap, or refresh rows without)."""
+    rows = []
+    for number, base in enumerate(world.rows):
+        history = kind == "states"
+        source = history_pair(world, number) if history else world.loader(world.root / base["path"])
+        row = dict(base, pair_id=f"{tag}-{number}", episode_id=f"{tag}-episode-{number}")
+        record = pair_record(source, row, state_source=STATE_SOURCE_ON_POLICY if history else STATE_SOURCE_M0,
+                             history=history)
+        path = root / "pairs" / f"{tag}-{base['case_id']}.npz"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        save_pair_npz(path, record)
+        rows.append(dict(pair_manifest_row(record, path, root=root), **(extra_fields(number) if extra_fields else {})))
+    manifest = root / "pairs.jsonl"
+    manifest.write_bytes("".join(json.dumps(row, sort_keys=True) + "\n" for row in rows).encode("utf-8"))
+    return manifest
+
